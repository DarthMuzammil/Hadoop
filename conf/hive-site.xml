<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- Embedded Derby metastore (single user) - enough for a single-node lab cluster. Copy into $HIVE_HOME/conf/ -->
<configuration>
  <property>
    <!-- Absolute path so "hive" works from any directory; __HOME__ is filled in by 08_install_hive.sh -->
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=__HOME__/hive_metastore/metastore_db;create=true</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/user/hive/warehouse</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.cli.print.header</name>
    <value>true</value>
  </property>
  <property>
    <!-- Run every query as a job on YARN (local mode would run inside the small Hive client JVM) -->
    <name>hive.exec.mode.local.auto</name>
    <value>false</value>
  </property>
</configuration>
